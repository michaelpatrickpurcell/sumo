\tikzset{pics/arrowcard/.style n args={3}{
code={
	\begin{scope}
	\clip (-\cardwidth/2 - \bleed, 0in) --%
	      (-\cardwidth/2 - \bleed, \cardheight/2 + \bleed) --%
	      (\cardwidth/2 + \bleed, \cardheight/2 + \bleed) --%
	      (\cardwidth/2 + \bleed, -\cardheight/2 - \bleed) --%
	      (-\cardwidth/2 - \bleed, -\cardheight/2 - \bleed) --%
	      cycle;
	      
	\path[fill=#2] (-\cardwidth/2 - \bleed, 0in) --%
	      (-\cardwidth/2 - \bleed, \cardheight/2 + \bleed) --%
	      (\cardwidth/2 + \bleed, \cardheight/2 + \bleed) --%
	      (\cardwidth/2 + \bleed, -\cardheight/2 - \bleed) --%
	      (-\cardwidth/2 - \bleed, -\cardheight/2 - \bleed) --%
	      cycle;

	% Pattern for card back

	\draw[line width=0.125in, #1] (0,1.625in) -- (0,-1.625in);
	\draw[line width=0.125in, #1] (-0.25in, -1.375in) -- (0,-1.625in) -- (0.25in, -1.375in);
	
	\node[rotate=-90, transform shape] at (0,0) {\includegraphics[height=2in]{Images/#1_sumo2.png}};	
	
	% Cutting guides for corners of the cards	
	\pic () at (0,0) {cutguide={#3}};
\end{scope}
}}}

